# Global environment for docker-compose and local bootstrapping.
NODE_ENV=development

# Backend runtime
PORT=3000
TRUST_PROXY_HOPS=0
REQUEST_BODY_LIMIT=100kb
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:5173
API_PREFIX=api
DEFAULT_API_VERSION=1

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-password

# JWT and cookies
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=crm-api
JWT_AUDIENCE=crm-web
REFRESH_COOKIE_NAME=crm_refresh_token
REFRESH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=crm_csrf_token

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_CSRF_COOKIE_NAME=crm_csrf_token
